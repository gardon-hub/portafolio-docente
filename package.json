{
  "name": "portafolio-docente-ardon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portafolio Docente 2026 de Gustavo Alonso Ardon - Facultad de Medicina Veterinaria y Zootecnia, Universidad Nacional de Agricultura (Honduras)",
  "scripts": {
    "dev": "vite --port 5178",
    "dev:red": "vite --host --port 5179",
    "build": "tsc -b && vite build && node herramientas/generar-sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src",
    "formato": "prettier --write \"src/**/*.{ts,tsx,css}\" \"content/*.json\" \"herramientas/*.mjs\" index.html",
    "publicar": "npm run build && node herramientas/publicar.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "oxlint": "^1.13.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "prettier": "^3.9.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
